# Byte-compiled Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Local virtualenvs
.venv/
venv/

# Editor and OS noise
.vscode/
.idea/
*.swp
.DS_Store

# Switchgear runtime artefacts. A state root is evidence, never source: it holds
# job records, captured provider streams and per-job sandbox homes. Committing
# one would publish whatever the workers read and wrote.
*-state/
state/
spend.jsonl
spend-rollup.jsonl

# Operator-owned configuration lives outside the repo by design
# (~/.config/switchgear/), but ignore a stray local copy anyway.
budget.json
providers.json
verified-providers.json
credentials/

# tests/live.sh IS committed. It is the opt-in live smoke test — it spends real
# money and is never run by CI, but it is the repeatable version of the walk
# that found the defects the hermetic suite structurally cannot.
