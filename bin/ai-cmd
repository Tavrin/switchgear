#!/usr/bin/env bash
# ai-cmd — argv-only constrained command runner.
# Never eval, never sh -c, never splits a shell string.
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname -- "$0")" && pwd)
AGENT_OPS_ROOT=$(cd "$SCRIPT_DIR/.." && pwd)
# shellcheck source=../lib/common.sh
source "$AGENT_OPS_ROOT/lib/common.sh"
# shellcheck source=../lib/validate.sh
source "$AGENT_OPS_ROOT/lib/validate.sh"
# shellcheck source=../lib/policy.sh
source "$AGENT_OPS_ROOT/lib/policy.sh"

usage() {
  echo 'usage: ai-cmd --dir <worktree> [--profile PATH] -- <verb> [args...]' >&2
  exit 2
}

dir=""
profile_arg=""
while [ $# -gt 0 ]; do
  case "$1" in
    --dir) [ $# -ge 2 ] || usage; dir=$2; shift 2 ;;
    --profile) [ $# -ge 2 ] || usage; profile_arg=$2; shift 2 ;;
    --) shift; break ;;
    -*) echo "ai-cmd: unknown flag $1" >&2; exit 2 ;;
    *) break ;;
  esac
done

[ -n "$dir" ] || usage
[ $# -ge 1 ] || usage

load_profile "$profile_arg"
abs=$(readlink -f -- "$dir")
assert_git_workdir "$abs"

python3 - "$AI_OPS_PROFILE_FILE" "$abs" "$@" <<'PY'
import json, os, re, sys

profile_path = sys.argv[1]
cwd = sys.argv[2]
verb = sys.argv[3]
args = sys.argv[4:]
if any(ch in verb for ch in ";|&`$()<>\n\r*?![]"):
    print("ai-cmd: REFUSING verb", file=sys.stderr)
    sys.exit(2)
for a in args:
    if any(ch in a for ch in ";|&`$()<>\n\r*?![]"):
        print(f"ai-cmd: REFUSING argument: {a}", file=sys.stderr)
        sys.exit(2)

profile = json.load(open(profile_path, encoding="utf-8"))
spec = (profile.get("commands") or {}).get(verb)
if not spec or not spec.get("argv"):
    print(f"ai-cmd: unknown verb: {verb}", file=sys.stderr)
    sys.exit(2)

pattern = spec.get("allowed_args_pattern") or r"^[A-Za-z0-9._/@:+=-]+$"
for a in args:
    if re.fullmatch(pattern, a) is None:
        print(f"ai-cmd: REFUSING argument (pattern): {a}", file=sys.stderr)
        sys.exit(2)

argv = list(spec["argv"]) + list(args)
os.chdir(cwd)
os.execvp(argv[0], argv)
PY
