#!/bin/sh
# Tiny launcher. No security decisions. exec the Python control plane.
# Resolve symlinks first: when installed as ~/.local/bin/switchgear -> here,
# $0 is the symlink, and deriving ROOT from it would point at the wrong tree.
SELF=$0
if command -v readlink >/dev/null 2>&1; then
  RESOLVED=$(readlink -f -- "$0" 2>/dev/null) && [ -n "$RESOLVED" ] && SELF=$RESOLVED
fi
ROOT=$(CDPATH= cd -- "$(dirname -- "$SELF")/.." && pwd)
# Prefer the interpreter that is actually active. Hardcoding /usr/bin/python3
# meant the repo launcher silently ignored a virtualenv, so a contributor could
# `pip install -e .` into a venv and still be running the system Python.
#
# -s stays: the control plane must not pick up the user site-packages directory.
PY_BIN=${SWITCHGEAR_PYTHON:-}
if [ -z "$PY_BIN" ] && [ -n "${VIRTUAL_ENV:-}" ] && [ -x "$VIRTUAL_ENV/bin/python3" ]; then
  PY_BIN=$VIRTUAL_ENV/bin/python3
fi
[ -n "$PY_BIN" ] || PY_BIN=$(command -v python3 2>/dev/null) || PY_BIN=/usr/bin/python3
exec "$PY_BIN" -s "$ROOT/python/switchgear/__main__.py" "$@"
