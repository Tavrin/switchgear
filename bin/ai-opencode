#!/usr/bin/env bash
# ai-opencode — generic OpenCode provider/worker wrapper.
# Not a manager. Does not create worktrees, merge, push, or mutate a tracker.
set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname -- "$0")" && pwd)
AGENT_OPS_ROOT=$(cd "$SCRIPT_DIR/.." && pwd)

# shellcheck source=../lib/common.sh
source "$AGENT_OPS_ROOT/lib/common.sh"
# shellcheck source=../lib/integrity.sh
source "$AGENT_OPS_ROOT/lib/integrity.sh"
# shellcheck source=../lib/validate.sh
source "$AGENT_OPS_ROOT/lib/validate.sh"
# shellcheck source=../lib/policy.sh
source "$AGENT_OPS_ROOT/lib/policy.sh"
# shellcheck source=../lib/routing.sh
source "$AGENT_OPS_ROOT/lib/routing.sh"
# shellcheck source=../lib/envelope.sh
source "$AGENT_OPS_ROOT/lib/envelope.sh"
# shellcheck source=../lib/result.sh
source "$AGENT_OPS_ROOT/lib/result.sh"
# shellcheck source=../lib/quota.sh
source "$AGENT_OPS_ROOT/lib/quota.sh"
# shellcheck source=../lib/review.sh
source "$AGENT_OPS_ROOT/lib/review.sh"
# shellcheck source=../lib/lease.sh
source "$AGENT_OPS_ROOT/lib/lease.sh"
# shellcheck source=../lib/process.sh
source "$AGENT_OPS_ROOT/lib/process.sh"
# shellcheck source=../lib/containment.sh
source "$AGENT_OPS_ROOT/lib/containment.sh"
# shellcheck source=../lib/opencode.sh
source "$AGENT_OPS_ROOT/lib/opencode.sh"

usage() {
  cat >&2 <<'EOF'
usage: ai-opencode [--profile PATH] models
       ai-opencode [--profile PATH] scout  <dir> "<prompt>"
       ai-opencode [--profile PATH] review <dir> <role> "<prompt>"
       ai-opencode [--profile PATH] run    --envelope FILE
       ai-opencode [--profile PATH] lease  acquire|release|show --dir <dir> --owner <id>
       ai-opencode [--profile PATH] status <job-id>
       ai-opencode [--profile PATH] write  <dir> <role> --envelope FILE
EOF
  exit 1
}

PROFILE_ARG=""
while [ $# -gt 0 ]; do
  case "$1" in
    --profile)
      [ $# -ge 2 ] || usage
      PROFILE_ARG=$2
      shift 2
      ;;
    --help|-h) usage ;;
    *) break ;;
  esac
done

load_profile "$PROFILE_ARG"
STATE=$(expand_state_dir)

HELPER="$AGENT_OPS_ROOT/bin/ai-ro"
[ -x "$HELPER" ] || refuse "missing $HELPER"

run_envelope_commands() {
  local envelope="$1" dir="$2"
  python3 - "$envelope" "$dir" "$AI_OPS_PROFILE_FILE" "$AGENT_OPS_ROOT/bin/ai-cmd" <<'PY'
import json, os, subprocess, sys
envelope, cwd, profile, ai_cmd = sys.argv[1:5]
env = json.load(open(envelope, encoding="utf-8"))
for item in env.get("commands") or []:
    verb = item.get("verb")
    args = item.get("args") or []
    if not verb:
        continue
    cmd = [ai_cmd, "--dir", cwd, "--profile", profile, "--", verb, *args]
    subprocess.check_call(cmd)
PY
}

write_job_result() {
  local jd="$1"
  python3 - "$jd/result.json" <<'PY'
import json, os, sys
path = sys.argv[1]
env = os.environ
obj = {
  "job_id": env["JOB_ID"],
  "status": env["JOB_STATUS"],
  "mode": env["JOB_MODE"],
  "role": env["JOB_ROLE"],
  "model": json.loads(env["JOB_MODEL_JSON"]),
  "dir": env["JOB_DIR"],
  "exit": int(env["JOB_EXIT"]) if env.get("JOB_EXIT", "") != "" else None,
  "started": env["JOB_STARTED"],
  "finished": env.get("JOB_FINISHED", ""),
  "attempt": int(env.get("JOB_ATTEMPT", "1")),
  "integrity": {
    "before": env.get("JOB_BEFORE", ""),
    "after": env.get("JOB_AFTER", ""),
    "changed": env.get("JOB_CHANGED", "false") == "true",
    "identity_changed": env.get("JOB_ID_CHANGED", "false") == "true",
  },
  "artifacts": {
    "events": os.path.join(os.path.dirname(path), "events.json"),
    "meta": os.path.join(os.path.dirname(path), "meta"),
    "tree": os.path.join(os.path.dirname(path), "tree.txt"),
    "handoff": os.path.join(os.path.dirname(path), "handoff.json") if os.path.exists(os.path.join(os.path.dirname(path), "handoff.json")) else None,
    "stderr": os.path.join(os.path.dirname(path), "stderr"),
  },
  "review": None,
  "process": {
    "pid": int(env["JOB_PID"]) if env.get("JOB_PID") else None,
    "pgid": int(env["JOB_PGID"]) if env.get("JOB_PGID") else None,
    "timed_out": env.get("JOB_TIMED_OUT", "0") == "1",
    "orphans_remaining": int(env.get("JOB_ORPHANS", "0")),
  },
}
if env.get("JOB_ERROR"):
    obj["error"] = env["JOB_ERROR"]
with open(path, "w", encoding="utf-8") as fh:
    json.dump(obj, fh, indent=2)
    fh.write("\n")
PY
}

run_provider_job() {
  local mode="$1" role="$2" dir="$3" prompt="$4" envelope="${5:-}"
  local model abs timeout_s stamp job agent agent_file
  local before after before_id after_id before_wt after_wt before_c after_c
  local rc=0

  model=$(role_model_id "$role") || refuse "unknown role: $role"
  assert_model_allowed "$model"
  local role_mode_expected
  role_mode_expected=$(role_mode "$role")
  [ "$role_mode_expected" = "$mode" ] || refuse "role $role is mode $role_mode_expected, not $mode"

  abs=$(readlink -f -- "$dir")
  assert_git_workdir "$abs"
  assert_profile_path_safe "$AI_OPS_PROFILE_FILE" "$abs"
  STATE=$(expand_state_dir)
  assert_state_isolated "$STATE" "$abs"
  assert_opencode_config_dir
  run_quota_hook
  timeout_s=$(resolve_timeout)
  assert_containment

  if [ -e "$abs/.opencode/agents/$(agent_name_for_mode "$mode").md" ]; then
    echo "ai-opencode: note — ignoring project agent file (DISABLE_PROJECT_CONFIG)" >&2
  fi

  agent=$(agent_name_for_mode "$mode")
  agent_file=$(agent_file_for_mode "$mode")
  [ -f "$agent_file" ] || refuse "missing $agent_file"

  stamp=$(utc_now)
  job="${stamp}-${role}-$$"
  JOB_ID=$job
  init_job "$job"
  local jd
  jd=$(job_dir "$job")

  pin_opencode_env "$mode" "$jd"

  snapshot_tree "$abs" > "$jd/integrity.tree.before"
  snapshot_git_identity "$abs" > "$jd/integrity.id.before"
  snapshot_other_worktrees "$abs" > "$jd/integrity.wt.before"
  snapshot_canaries > "$jd/integrity.canary.before"
  snapshot_outside_bindings "$abs" > "$jd/integrity.outside.before"
  before=$(sha256sum "$jd/integrity.tree.before" | awk '{print $1}')
  before_id=$(sha256sum "$jd/integrity.id.before" | awk '{print $1}')
  before_wt=$(sha256sum "$jd/integrity.wt.before" | awk '{print $1}')
  before_c=$(sha256sum "$jd/integrity.canary.before" | awk '{print $1}')
  before_out=$(sha256sum "$jd/integrity.outside.before" | awk '{print $1}')

  write_tree_snapshot_file "$abs" "$jd/tree.txt" "$HELPER"

  {
    echo "dir=$abs"
    echo "role=$role"
    echo "mode=$mode"
    echo "model=$model"
    echo "agent=$agent"
    echo "agent_file=$agent_file"
    echo "started=$stamp"
    echo "pid=$$"
    echo "pure=1"
    echo "disable_project_config=1"
    echo "tree=$jd/tree.txt"
  } > "$jd/meta"

  local wrapped
  wrapped=$(printf '%s\n\n%s\n' \
    "The wrapper attached a tree snapshot at $jd/tree.txt. Use only Read, Grep, and Glob unless this is a bounded-write job (edit inside the worktree only; no shell)." \
    "$prompt")

  export JOB_ID JOB_MODE="$mode" JOB_ROLE="$role" JOB_DIR="$abs" JOB_STARTED="$stamp"
  export JOB_MODEL_JSON
  JOB_MODEL_JSON=$(model_object "$model")
  export JOB_ATTEMPT=1
  if [ -n "$envelope" ]; then
    JOB_ATTEMPT=$(envelope_get "$envelope" attempt 1)
    export JOB_ATTEMPT
  fi

  set +e
  run_in_session "$timeout_s" "$jd/events.json" "$jd/stderr" -- \
    opencode run \
      --pure \
      --dir "$abs" \
      --model "$model" \
      --agent "$agent" \
      --format json \
      --title "ai-opencode $role $$" \
      "$wrapped"
  rc=$?
  set -e

  {
    echo "exit=$rc"
    echo "finished=$(utc_now)"
    echo "pgid=${PROC_PGID:-}"
    echo "timed_out=${PROC_TIMED_OUT:-0}"
    echo "orphans=${PROC_ORPHANS:-0}"
  } >> "$jd/meta"

  snapshot_tree "$abs" > "$jd/integrity.tree.after"
  snapshot_git_identity "$abs" > "$jd/integrity.id.after"
  snapshot_other_worktrees "$abs" > "$jd/integrity.wt.after"
  snapshot_canaries > "$jd/integrity.canary.after"
  snapshot_outside_bindings "$abs" > "$jd/integrity.outside.after"
  after=$(sha256sum "$jd/integrity.tree.after" | awk '{print $1}')
  after_id=$(sha256sum "$jd/integrity.id.after" | awk '{print $1}')
  after_wt=$(sha256sum "$jd/integrity.wt.after" | awk '{print $1}')
  after_c=$(sha256sum "$jd/integrity.canary.after" | awk '{print $1}')
  after_out=$(sha256sum "$jd/integrity.outside.after" | awk '{print $1}')

  export JOB_EXIT="$rc"
  export JOB_FINISHED
  JOB_FINISHED=$(utc_now)
  export JOB_BEFORE="$before" JOB_AFTER="$after"
  export JOB_PID="${PROC_PID:-}" JOB_PGID="${PROC_PGID:-}"
  export JOB_TIMED_OUT="${PROC_TIMED_OUT:-0}" JOB_ORPHANS="${PROC_ORPHANS:-0}"
  export JOB_CHANGED=false JOB_ID_CHANGED=false JOB_STATUS="" JOB_ERROR=""

  if [ "${PROC_TIMED_OUT:-0}" -eq 1 ]; then
    JOB_STATUS=timeout
    JOB_ERROR="timed out after ${timeout_s}s"
  fi
  if [ "${PROC_ORPHANS:-0}" -gt 0 ]; then
    JOB_STATUS=${JOB_STATUS:-provider_error}
    JOB_ERROR="orphans_remaining=${PROC_ORPHANS}"
  fi

  if [ "$before_id" != "$after_id" ] || [ "$before_wt" != "$after_wt" ]; then
    JOB_ID_CHANGED=true
  fi
  if [ "$before" != "$after" ]; then
    JOB_CHANGED=true
  fi
  if [ "$before_c" != "$after_c" ]; then
    JOB_CHANGED=true
    JOB_ERROR="${JOB_ERROR:+$JOB_ERROR; }canary changed"
  fi
  if [ "$before_out" != "$after_out" ]; then
    JOB_CHANGED=true
    JOB_ERROR="${JOB_ERROR:+$JOB_ERROR; }escape-binding changed"
  fi

  if [ "$mode" = readonly ]; then
    if [ "$JOB_CHANGED" = true ] || [ "$JOB_ID_CHANGED" = true ]; then
      JOB_STATUS=dirty
      echo "ai-opencode: REFUSING — tree integrity changed in $abs" >&2
      echo "  (HEAD, porcelain, diff hash, dirty-file content, or git identity)" >&2
      echo "exit=dirty" >> "$jd/meta"
      export JOB_STATUS JOB_ERROR JOB_CHANGED JOB_ID_CHANGED
      write_job_result "$jd"
      print_job_stdout "$model" "$abs" 2 "$job"
      exit 2
    fi
    if [ -z "$JOB_STATUS" ]; then
      if [ "$rc" -ne 0 ]; then
        JOB_STATUS=provider_error
      else
        JOB_STATUS=ok
      fi
    fi
  else
    if [ "$JOB_ID_CHANGED" = true ]; then
      JOB_STATUS=dirty
      JOB_ERROR="${JOB_ERROR:+$JOB_ERROR; }git identity changed"
    fi
    if [[ "${JOB_ERROR:-}" == *escape* ]] || [[ "${JOB_ERROR:-}" == *canary* ]]; then
      JOB_STATUS=dirty
    fi
    if [ -z "$JOB_STATUS" ] || [ "$JOB_STATUS" = "ok" ]; then
      local hr
      set +e
      jsonutil extract-handoff "$jd/events.json" > "$jd/handoff.json"
      hr=$?
      set -e
      if [ "$hr" -eq 3 ]; then
        JOB_STATUS=provider_error
        JOB_ERROR="malformed provider JSON"
        rm -f "$jd/handoff.json"
      elif [ "$hr" -ne 0 ]; then
        JOB_STATUS=provider_error
        JOB_ERROR="missing handoff"
        rm -f "$jd/handoff.json"
      else
        python3 - "$jd/handoff.json" > "$jd/handoff.txt" <<'PY'
import json, sys
h = json.load(open(sys.argv[1], encoding="utf-8"))
print(h.get("summary", ""))
PY
        if [ -n "$envelope" ]; then
          run_envelope_commands "$envelope" "$abs" || {
            JOB_STATUS=provider_error
            JOB_ERROR="post-write command failed"
          }
        fi
        if [ -z "$JOB_STATUS" ]; then
          JOB_STATUS=awaiting_review
        fi
      fi
    fi
  fi

  export JOB_STATUS JOB_ERROR JOB_CHANGED JOB_ID_CHANGED
  write_job_result "$jd"

  if [ -n "$envelope" ]; then
    local parent
    parent=$(envelope_get "$envelope" parent_job "")
    if [ -n "$parent" ] && [ "$mode" = readonly ] && [ "$JOB_STATUS" = ok ]; then
      local subj_model rev_file indep_file
      subj_model=$(job_dir "$parent")/result.json
      [ -f "$subj_model" ] || refuse "parent job result missing: $parent"
      python3 - "$subj_model" "$jd" <<'PY'
import json, sys
parent = json.load(open(sys.argv[1], encoding="utf-8"))
open(sys.argv[2] + "/subject_model.json", "w").write(json.dumps(parent["model"]))
PY
      echo "$JOB_MODEL_JSON" > "$jd/reviewer_model.json"
      indep_file=$jd/independence.json
      compute_independence "$jd/subject_model.json" "$jd/reviewer_model.json" "$parent" "$job" > "$indep_file"
      local unmet
      set +e
      unmet=$(unmet_required "$indep_file")
      local urc=$?
      set -e
      python3 - "$jd/review.json" "$parent" "$job" "$JOB_MODEL_JSON" "$role" "$indep_file" "$unmet" <<'PY'
import json, sys
dest, subject, reviewer, model_s, role, indep_p, unmet_s = sys.argv[1:8]
obj = {
  "subject_job": subject,
  "reviewer_job": reviewer,
  "model": json.loads(model_s),
  "role": role,
  "independence": json.load(open(indep_p, encoding="utf-8")),
  "verdict": "attack",
  "findings": [],
  "required_unmet": json.loads(unmet_s or "[]"),
}
json.dump(obj, open(dest, "w", encoding="utf-8"), indent=2)
PY
      attach_review_to_subject "$parent" "$job" "$jd/review.json"
    fi
  fi

  print_job_stdout "$model" "$abs" "$rc" "$job"
  if [ "$JOB_STATUS" = dirty ]; then
    exit 2
  fi
  if [ "$rc" -ne 0 ]; then
    echo "ai-opencode: provider exited $rc" >&2
    tail -20 "$jd/stderr" >&2 || true
    exit "$rc"
  fi
  case "$JOB_STATUS" in
    timeout) exit 124 ;;
    provider_error|review_failed) exit 1 ;;
  esac
}

cmd_write() {
  local dir role envelope=""
  [ $# -ge 2 ] || usage
  dir=$1
  role=$2
  shift 2
  while [ $# -gt 0 ]; do
    case "$1" in
      --envelope) envelope=$2; shift 2 ;;
      *) break ;;
    esac
  done
  [ -n "$envelope" ] || refuse "write requires --envelope FILE"
  validate_envelope_file "$envelope"
  if [ "${AI_OPS_WRITE:-}" != "1" ]; then
    refuse "write is disabled (AI_OPS_WRITE is not 1)"
  fi
  write_enabled || refuse "profile write_enabled is false"
  local abs
  abs=$(readlink -f -- "$dir")
  assert_git_workdir "$abs"
  local req_wt req_lease
  req_wt=$(profile_get worktree.require_linked_worktree_for_write true)
  req_lease=$(profile_get worktree.require_lease_for_write true)
  [ "$req_wt" = "true" ] && assert_linked_worktree "$abs"
  [ "$req_lease" = "true" ] && assert_live_lease "$abs"
  local env_mode env_role env_cwd
  env_mode=$(envelope_get "$envelope" mode)
  env_role=$(envelope_get "$envelope" role)
  env_cwd=$(readlink -f -- "$(envelope_get "$envelope" cwd)")
  [ "$env_mode" = "bounded-write" ] || refuse "envelope mode must be bounded-write"
  [ "$env_role" = "$role" ] || refuse "envelope role mismatch"
  [ "$env_cwd" = "$abs" ] || refuse "envelope cwd mismatch"
  local prompt
  prompt=$(envelope_get "$envelope" goal)
  run_provider_job bounded-write "$role" "$abs" "$prompt" "$envelope"
}

cmd_run() {
  local envelope=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --envelope) envelope=$2; shift 2 ;;
      *) usage ;;
    esac
  done
  [ -n "$envelope" ] || refuse "run requires --envelope FILE"
  validate_envelope_file "$envelope"
  local mode role cwd prompt
  mode=$(envelope_get "$envelope" mode)
  role=$(envelope_get "$envelope" role)
  cwd=$(envelope_get "$envelope" cwd)
  prompt=$(envelope_get "$envelope" goal)
  if [ "$mode" = "bounded-write" ]; then
    cmd_write "$cwd" "$role" --envelope "$envelope"
  else
    run_provider_job readonly "$role" "$cwd" "$prompt" "$envelope"
  fi
}

cmd=${1:-}
shift || true

case "$cmd" in
  models)
    discover_models
    ;;
  scout)
    [ $# -ge 2 ] || usage
    run_provider_job readonly scout "$1" "$2"
    ;;
  review)
    [ $# -ge 3 ] || usage
    dir=$1; role=$2; shift 2
    envfile=""
    prompt=""
    if [ "${1:-}" = --envelope ]; then
      envfile=$2
      validate_envelope_file "$envfile"
      prompt=$(envelope_get "$envfile" goal)
    else
      prompt=${1:-}
    fi
    run_provider_job readonly "$role" "$dir" "$prompt" "$envfile"
    ;;
  run)
    cmd_run "$@"
    ;;
  write)
    cmd_write "$@"
    ;;
  lease)
    sub=${1:-}
    shift || true
    ldir="" lowner="" lpid=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --dir) ldir=$2; shift 2 ;;
        --owner) lowner=$2; shift 2 ;;
        --owner-pid) lpid=$2; shift 2 ;;
        *) break ;;
      esac
    done
    case "$sub" in
      acquire) [ -n "$ldir" ] && [ -n "$lowner" ] || usage; lease_acquire "$ldir" "$lowner" "$lpid" ;;
      release) [ -n "$ldir" ] || usage; lease_release "$ldir" ;;
      show) [ -n "$ldir" ] || usage; lease_show "$ldir" ;;
      *) usage ;;
    esac
    ;;
  status)
    [ $# -ge 1 ] || usage
    jd=$(job_dir "$1")
    [ -f "$jd/result.json" ] || refuse "unknown job $1"
    cat "$jd/result.json"
    ;;
  *)
    usage
    ;;
esac
