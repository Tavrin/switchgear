{
  "providers": {
    "opencode-go": {
      "upstream": "https://opencode.ai/zen/go/v1",
      "credential": "opencode-go"
    },
    "openrouter": {
      "upstream": "https://openrouter.ai/api/v1",
      "credential": "openrouter"
    }
  },
  "models": {
