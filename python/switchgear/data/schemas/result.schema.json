{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Job result",
  "type": "object",
  "required": [
    "job_id",
    "status",
    "mode",
    "role",
    "model",
    "dir",
    "exit",
    "started",
    "generation"
  ],
  "additionalProperties": false,
  "properties": {
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "refused",
        "dirty",
        "timeout",
        "provider_error",
        "awaiting_review",
        "review_failed"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "readonly",
        "bounded-write"
      ]
    },
    "role": {
      "type": "string"
    },
    "model": {
      "$ref": "model.schema.json"
    },
    "dir": {
      "type": "string"
    },
    "exit": {
      "type": [
        "integer",
        "null"
      ]
    },
    "started": {
      "type": "string"
    },
    "finished": {
      "type": "string"
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "integrity": {
      "type": "object",
      "properties": {
        "git_identity_before": {
          "type": "string"
        },
        "git_identity_after": {
          "type": "string"
        },
        "tree_before": {
          "type": "string"
        },
        "tree_after": {
          "type": "string"
        },
        "identity_changed": {
          "type": "boolean"
        }
      }
    },
    "freeze": {
      "type": [
        "object",
        "null"
      ]
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "review": {
      "type": [
        "object",
        "null"
      ]
    },
    "process": {
      "type": "object",
      "properties": {
        "pid": {
          "type": [
            "integer",
            "null"
          ]
        },
        "timed_out": {
          "type": "boolean"
        }
      }
    },
    "policy_digest": {
      "type": "string"
    },
    "profile_digest": {
      "type": "string"
    },
    "error": {
      "type": "string"
    },
    "lease_uuid": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider_calls": {
      "type": "object",
      "properties": {
        "forwarded": {
          "type": "integer"
        },
        "denied": {
          "type": "integer"
        },
        "denied_detail": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "transport": {
          "type": "integer"
        }
      }
    },
    "cost_usd": {
      "type": "number",
      "minimum": 0,
      "description": "Measured cost of this job in USD, summed from the provider's own per-step figures. Not an estimate."
    },
    "resumed": {
      "type": "object",
      "properties": {
        "session": {
          "type": "string"
        },
        "from_job": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "description": "Set when this job continued a prior provider session. A resumed job is new work with its own evidence, but its model already held context from the named job."
    },
    "review_of": {
      "type": [
        "string",
        "null"
      ],
      "description": "The subject job this review was of, recorded on the REVIEWER's record before promotion is attempted. Without it an unpromoted review chain is invisible to retention."
    },
    "effort": {
      "type": [
        "string",
        "null"
      ],
      "description": "reasoning-effort value sent to the provider, null if none"
    },
    "secrets_suspected": {
      "type": "array",
      "description": "advisory findings: worker output matched a secret-shaped pattern. Never contains the matched value. Does not affect status.",
      "items": {
        "type": "object",
        "required": [
          "pattern",
          "where",
          "count"
        ],
        "properties": {
          "pattern": {
            "type": "string"
          },
          "where": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          }
        }
      }
    },
    "queued_s": {
      "type": "number",
      "description": "seconds spent waiting for a concurrency slot (0 when unlimited)"
    },
    "provider": {
      "type": "string",
      "description": "adapter that ran this job (the provider BINARY, not the model pool)"
    },
    "agent_directed_content": {
      "type": "array",
      "description": "advisory: content in this job's stream is shaped like instructions addressed at an agent. Blocks automatic promotion at the gate.",
      "items": {
        "type": "object"
      }
    },
    "spend_unrecorded": {
      "type": "string",
      "description": "set when this job's cost could not be appended to the ledger; the daily budget is under-counting by this job"
    }
  }
}
