{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Independent review artifact",
  "type": "object",
  "required": [
    "subject_job",
    "reviewer_job",
    "model",
    "role",
    "independence",
    "verdict",
    "subject_head",
    "subject_tree_digest",
    "subject_policy_digest",
    "reviewed_dir",
    "reviewed_tree_digest",
    "models_registry_digest",
    "reviewed_files"
  ],
  "additionalProperties": false,
  "properties": {
    "subject_job": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_job": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "$ref": "model.schema.json"
    },
    "role": {
      "type": "string"
    },
    "independence": {
      "type": "object",
      "required": [
        "different_job",
        "different_model",
        "different_family",
        "different_provider"
      ],
      "additionalProperties": false,
      "properties": {
        "different_job": {
          "type": "boolean"
        },
        "different_model": {
          "type": "boolean"
        },
        "different_family": {
          "type": "boolean"
        },
        "different_provider": {
          "type": "boolean"
        }
      }
    },
    "verdict": {
      "type": "string",
      "enum": [
        "promote",
        "reject",
        "needs_changes"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "subject_head": {
      "type": "string"
    },
    "subject_tree_digest": {
      "type": "string"
    },
    "subject_policy_digest": {
      "type": "string"
    },
    "reviewed_dir": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_tree_digest": {
      "type": "string",
      "minLength": 1
    },
    "models_registry_digest": {
      "type": "string",
      "minLength": 1
    },
    "required_unmet": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
