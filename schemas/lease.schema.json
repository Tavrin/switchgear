{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Worktree lease",
  "type": "object",
  "required": [
    "lease_uuid",
    "owner",
    "owner_pid",
    "owner_starttime",
    "boot_id",
    "acquired_at",
    "realpath",
    "mode"
  ],
  "additionalProperties": false,
  "properties": {
    "lease_uuid": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "owner_pid": { "type": "integer", "minimum": 1 },
    "owner_starttime": { "type": "string", "minLength": 1 },
    "boot_id": { "type": "string", "minLength": 1 },
    "acquired_at": { "type": "string", "minLength": 1 },
    "realpath": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "enum": ["readonly", "bounded-write"] },
    "replaced_stale": { "type": "boolean" }
  }
}
