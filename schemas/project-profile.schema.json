{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Project profile",
  "type": "object",
  "required": ["name", "provider", "state_dir", "models", "roles"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "enum": ["opencode"] },
    "state_dir": { "type": "string", "minLength": 1 },
    "timeout_s": { "type": "integer", "minimum": 1, "maximum": 1800 },
    "timeout_env": { "type": "string" },
    "timeout_min": { "type": "integer", "minimum": 1 },
    "timeout_max": { "type": "integer", "maximum": 1800 },
    "models": {
      "type": "object",
      "required": ["allow"],
      "additionalProperties": false,
      "properties": {
        "allow": { "type": "array", "items": { "type": "string" } },
        "deny": { "type": "array", "items": { "type": "string" } },
        "catalog": {
          "type": "array",
          "items": { "$ref": "model.schema.json" }
        }
      }
    },
    "roles": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["model", "mode"],
        "properties": {
          "model": { "type": "string" },
          "mode": { "type": "string", "enum": ["readonly", "bounded-write"] }
        }
      }
    },
    "external_read": { "type": "array", "items": { "type": "string" } },
    "quota_hook": {
      "type": ["array", "null"],
      "items": { "type": "string" }
    },
    "review": {
      "type": "object",
      "properties": {
        "required_after_write": { "type": "boolean" },
        "independence": {
          "type": "object",
          "properties": {
            "different_job": { "type": "string", "enum": ["required", "preferred", "optional"] },
            "different_model": { "type": "string", "enum": ["required", "preferred", "optional"] },
            "different_family": { "type": "string", "enum": ["required", "preferred", "optional"] },
            "different_provider": { "type": "string", "enum": ["required", "preferred", "optional"] }
          }
        }
      }
    },
    "worktree": {
      "type": "object",
      "properties": {
        "require_linked_worktree_for_write": { "type": "boolean" },
        "require_lease_for_write": { "type": "boolean" },
        "allow_primary_for_readonly": { "type": "boolean" }
      }
    },
    "write_enabled": { "type": "boolean" },
    "containment": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["none", "bwrap"] },
        "required": { "type": "boolean" }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["argv"],
        "properties": {
          "argv": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "allowed_args_pattern": { "type": "string" }
        }
      }
    }
  }
}
